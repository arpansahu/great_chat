pipeline {
    agent any
    environment {
        IMAGE_TAG = "${env.BUILD_ID}"
    }
    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        stage('Setup Environment') {
            steps {
                script {
                    // Load .env from Jenkins credentials
                    withCredentials([file(credentialsId: 'great_chat_env_file', variable: 'ENV_FILE')]) {
                        // Remove existing .env file if it exists (handles read-only files)
                        sh 'rm -f .env || true'
                        
                        def envContent = readFile(file: env.ENV_FILE)
                        writeFile(file: '.env', text: envContent)
                        
                        // Parse and set environment variables
                        def envVars = envContent.split('\n').findAll { it.trim() && !it.startsWith('#') }
                        envVars.each { line ->
                            def parts = line.split('=', 2)
                            if (parts.size() == 2) {
                                def key = parts[0].trim()
                                def value = parts[1].trim()
                                env."${key}" = value
                            }
                        }
                        
                        // Set Jenkins-specific variables from .env
                        env.BUILD_PROJECT_NAME = "${env.ENV_PROJECT_NAME}_build"
                        env.PROJECT_NAME_WITH_DASH = env.ENV_PROJECT_NAME.replace('_', '-')
                        env.REGISTRY = env.DOCKER_REGISTRY
                        env.REPOSITORY = "${env.DOCKER_REPOSITORY}/${env.DOCKER_IMAGE_NAME}"
                    }
                }
            }
        }
        stage('Run Unit Tests') {
            steps {
                script {
                    echo "Running unit tests..."
                    sh """
                    docker run --rm -v \$(pwd):/app -w /app --env-file .env python:3.10.7 \\
                        bash -c 'pip install -q -r requirements.txt && \\
                                 python -m pytest -m "not ui and not todo" --ignore=tests -v --tb=short'
                    """
                }
            }
        }
        stage('Run UI Tests') {
            steps {
                script {
                    echo "Running UI tests with Playwright..."
                    sh """
                    docker run --rm -v \$(pwd):/app -w /app --env-file .env \\
                        mcr.microsoft.com/playwright/python:v1.40.0-jammy bash -c '
                            pip install -q -r requirements.txt
                            playwright install chromium
                            
                            # Run UI tests with pytest-django live_server
                            # No need to manually start runserver - live_server fixture handles it
                            pytest */test_ui.py -m "ui and not todo" -v --tb=short -x
                        '
                    """
                }
            }
        }
        stage('Build Image') {
            steps {
                script {
                    // Build Docker image
                    sh """
                    docker build -t ${env.REPOSITORY}:${env.IMAGE_TAG} -t ${env.REPOSITORY}:latest .
                    """
                }
            }
        }
        stage('Push to Registry') {
            steps {
                script {
                    try {
                        // Login to Docker registry (skip if credentials not configured)
                        withCredentials([usernamePassword(credentialsId: 'docker_credentials', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                            sh """
                            echo \$DOCKER_PASSWORD | docker login ${env.REGISTRY} -u \$DOCKER_USERNAME --password-stdin
                            docker push ${env.REPOSITORY}:${env.IMAGE_TAG}
                            docker push ${env.REPOSITORY}:latest
                            """
                        }
                        echo "✅ Successfully pushed images to registry"
                    } catch (Exception e) {
                        echo "⚠️ Skipping Docker push - credentials not configured: ${e.message}"
                        echo "To enable: Add 'docker_credentials' in Jenkins → Manage Jenkins → Credentials"
                    }
                }
            }
        }
    }
    post {
        success {
            script {
                // Send success notification email using env vars
                withCredentials([file(credentialsId: 'great_chat_env_file', variable: 'ENV_FILE')]) {
                    sh """
                    # Load env vars for email
                    export \$(cat ${ENV_FILE} | grep -v '^#' | xargs)
                    
                    curl -s \\
                    -X POST \\
                    --user \${MAIL_JET_API_KEY}:\${MAIL_JET_API_SECRET} \\
                    https://api.mailjet.com/v3.1/send \\
                    -H "Content-Type:application/json" \\
                    -d '{
                        "Messages":[
                                {
                                        "From": {
                                                "Email": "'\${MAIL_JET_EMAIL_ADDRESS}'",
                                                "Name": "ArpanSahuOne Jenkins Notification"
                                        },
                                        "To": [
                                                {
                                                        "Email": "'\${MY_EMAIL_ADDRESS}'",
                                                        "Name": "Development Team"
                                                }
                                        ],
                                        "Subject": "${currentBuild.description}",
                                        "TextPart": "Hola Development Team, your project ${currentBuild.fullDisplayName} : ${currentBuild.description}",
                                        "HTMLPart": "<h3>Hola Development Team, your project ${currentBuild.fullDisplayName} : ${currentBuild.description} </h3> <br> <p> Build Url: ${env.BUILD_URL}  </p>"
                                }
                        ]
                    }'
                    """
                }

                // Trigger deploy job dynamically
                build job: "${env.ENV_PROJECT_NAME}_deploy", parameters: [booleanParam(name: 'DEPLOY', value: true)], wait: false
            }
        }
        failure {
            script {
                // Send failure notification email
                sh """curl -s \
                -X POST \
                --user $MAIL_JET_API_KEY:$MAIL_JET_API_SECRET \
                https://api.mailjet.com/v3.1/send \
                -H "Content-Type:application/json" \
                -d '{
                    "Messages":[
                            {
                                    "From": {
                                            "Email": "$MAIL_JET_EMAIL_ADDRESS",
                                            "Name": "ArpanSahuOne Jenkins Notification"
                                    },
                                    "To": [
                                            {
                                                    "Email": "$MY_EMAIL_ADDRESS",
                                                    "Name": "Development Team"
                                            }
                                    ],
                                    "Subject": "${currentBuild.fullDisplayName} build failed",
                                    "TextPart": "Hola Development Team, your project ${currentBuild.fullDisplayName} build failed ${currentBuild.description} ",
                                    "HTMLPart": "<h3>Hola Development Team, your project ${currentBuild.fullDisplayName} build failed </h3> <br> <p> ${currentBuild.description}  </p>"
                            }
                    ]
                }'"""
            }
        }
    }
}